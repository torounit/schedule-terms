{
	"name": "@torounit/schedule-terms",
	"version": "2.0.1",
	"private": true,
	"author": "Hiroshi Urabe <mail@torounit.com> (https://torounit.com)",
	"license": "GPL-2.0+",
	"scripts": {
		"wp-env": "wp-env",
		"test:php": "npm run test:php:setup && npm run test:php:base",
		"test:php:setup": "wp-env --config=.wp-env.test.json start",
		"test:php:base": "wp-env --config=.wp-env.test.json run --env-cwd='wp-content/plugins/schedule-terms' wordpress vendor/bin/phpunit -c phpunit.xml.dist",
		"packages-update": "wp-scripts packages-update",
		"lint-php": "./vendor/bin/phpcs --standard=./phpcs.xml.dist --warning-severity=6",
		"test": "wp-scripts test-unit-js",
		"start": "wp-scripts start ./src/admin/ ./src/editor/",
		"build": "wp-scripts build ./src/admin/ ./src/editor/",
		"format": "wp-scripts format",
		"lint-js": "wp-scripts lint-js",
		"lint-js:fix": "wp-scripts lint-js --fix",
		"lint:type": "tsc",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/torounit/schedule-terms.git"
	},
	"devDependencies": {
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.js": [
			"npm run format-js",
			"npm run lint-js"
		],
		"*.php": [
			"npm run lint-php"
		]
	},
	"dependencies": {
		"@wordpress/components": "^43.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/plugins": "^8.0.0",
		"moment": "^2.31.0",
		"wp-types": "^4.71.0"
	}
}
